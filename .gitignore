# ---- Secrets: never commit ----
local.properties
*.jks
*.keystore
# The shared debug key is not a secret (password "android"); it keeps debug builds from CI and
# every laptop installable over each other. Release keys stay ignored.
!app/debug.keystore
keystore.properties
secrets.properties
google-services.json

# ---- Gradle ----
.gradle/
build/
captures/
.cxx/
*.hprof

# ---- Android ----
/app/release/
/app/debug/
*.apk
*.aab
*.ap_
*.dex
output.json
release/

# ---- IDE ----
.idea/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db

# ---- Kotlin / misc ----
.kotlin/
*.log
local.log

# ---- OSM import cache (regenerable) ----
tools/import_osm/.cache/

# ---- Supabase database connection (contains the DB password) ----
supabase/.db-url

# ---- Tool caches ----
__pycache__/
tools/map_style/.cache/
tools/import_external/.cache/

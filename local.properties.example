## Copy this file to `local.properties` and fill in your own values.
## `local.properties` is git-ignored — never commit it (KANTA_SPEC.md §9.2).

# Android SDK location (Android Studio writes this for you)
sdk.dir=/home/ivan/Android/Sdk

# Supabase project credentials — Dashboard > Project Settings > Data API / API Keys
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
